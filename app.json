{
  "expo": {
    "name": "Kampus",
    "slug": "kampus",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "az.kampus.wallet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5632c0"
      },
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kampus QR ödəniş üçün kameranı istifadə edir.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withDemoNetwork",
      "./plugins/withReleaseSigning",
      "expo-sharing",
      "expo-font",
      "expo-status-bar"
    ],
    "scheme": "kampus"
  }
}
